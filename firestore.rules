rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email.lower() == 'banglaworld247@gmail.com' ||
         request.auth.token.admin == true);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Tuitions Collection (Public offers & jobs)
    match /tuitions/{tuitionId} {
      // Anyone can read active/published tuition postings
      allow read: if true;
      // Only verified admins can create, update, or delete tuitions
      allow create, update, delete: if isAdmin();
    }

    // 2. Tutors Collection (Registered tutor profiles)
    match /tutors/{tutorId} {
      // Public / Students can view verified tutors, or tutor can view their own, or admin
      allow read: if true;
      // Tutor can create/update only their own profile, admin can edit any
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.auth.uid == tutorId);
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == tutorId || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Applications Collection (Tutor job applications)
    match /applications/{appId} {
      // Tutors can read their own applications, Admin can read all
      allow read: if isAuthenticated() && (resource.data.tutorUid == request.auth.uid || isAdmin());
      // Authenticated tutors can create applications for themselves
      allow create: if isAuthenticated() && request.resource.data.tutorUid == request.auth.uid;
      // Only admin can update status (approve/reject/shortlist) or delete
      allow update, delete: if isAdmin();
    }

    // 4. Settings Collection (WhatsApp credentials, API tokens, admin preferences)
    match /settings/{settingId} {
      // Sensitive credentials must ONLY be readable and writable by admins
      allow read, write: if isAdmin();
    }

    // 5. Default catch-all rule: Deny all other access
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
