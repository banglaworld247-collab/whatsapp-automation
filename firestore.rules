rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email.lower() in ['banglaworld247@gmail.com', 'gdgourob32@gmail.com'] ||
         request.auth.token.admin == true);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Tuitions Collection (Public offers & jobs)
    match /tuitions/{tuitionId} {
      // Anyone can read active/published tuition postings
      allow read: if true;
      // Only verified admins can create, update, or delete tuitions
      allow create, update, delete: if isAdmin();
    }

    // 2. Tutors Collection (Registered tutor profiles)
    match /tutors/{tutorId} {
      // Public can view tutor profiles
      allow read: if true;
      // Tutor can create/update their own profile, admin can edit any
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.auth.uid == tutorId);
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == tutorId || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Applications Collection (Tutor job applications)
    match /applications/{appId} {
      // Tutors can read their own applications, Admin can read all
      allow read: if isAuthenticated() && (resource.data.tutorUid == request.auth.uid || isAdmin());
      // Authenticated tutors can create applications for themselves
      allow create: if isAuthenticated() && request.resource.data.tutorUid == request.auth.uid;
      // Only admin can update status (approve/reject/shortlist) or delete
      allow update, delete: if isAdmin();
    }

    // 4. Tuition Requests Collection (Parent/Guardian tutor requests)
    match /tuitionRequests/{reqId} {
      // Anyone (even guest guardians) can submit a tutor request
      allow create: if true;
      // Admins can read and manage all requests, requester can read if authenticated
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 5. Verifications Collection (NID / Student ID documents)
    match /verifications/{verId} {
      // Tutor can read and submit their own verification request, admin can read/manage all
      allow read: if isAuthenticated() && (resource.data.tutorUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.tutorUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 6. Reviews Collection (Student/Guardian feedback)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() || true; // Allow verified guardian submissions
      allow update, delete: if isAdmin();
    }

    // 7. Progress Logs Collection (Tutor study tracking logbook)
    match /progressLogs/{logId} {
      allow read: if isAuthenticated() && (resource.data.tutorUid == request.auth.uid || resource.data.guardianUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.tutorUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.tutorUid == request.auth.uid || isAdmin());
    }

    // 8. Settings Collection (WhatsApp credentials, API tokens, admin preferences)
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
